resolver ${NGINX_LOCAL_RESOLVERS} valid=5s ipv6=off;
upstream sanketApi {
    zone sanketApi 64k;
    server api:8000 resolve;
}

server {
    listen 80;
    root /usr/share/nginx/html;
    location /api/ {
        proxy_pass http://sanketApi/;
        proxy_set_header Host $host;
    }
    location / { try_files $uri /index.html; }
}
